{
  "name": "triangle-toss",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "https:setup": "node scripts/https-setup.mjs",
    "dev:https": "npm run https:setup && vite --mode https --host 0.0.0.0 --port 5174 --strictPort",
    "build": "npm run check && vite build && node scripts/size.mjs",
    "build:demo": "vite build --mode demo",
    "build:obfuscated": "npm run build && node scripts/obfuscate.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc --noEmit && oxlint src tests scripts vite.config.ts",
    "test": "vitest run",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "javascript-obfuscator": "^4.1.1",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.0.0"
  }
}
